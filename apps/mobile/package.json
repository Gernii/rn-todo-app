	"devDependencies": {
		"@biomejs/biome": "2.4.15",
		"@inlang/cli": "^3.0.0",
		"@inlang/paraglide-js": "^2.18.1",
		"@testing-library/jest-native": "^5.4.3",
		"@testing-library/react-native": "^13.3.3",
		"@types/react": "~19.2.2",
		"concurrently": "^9.2.1",
		"cross-env": "^10.1.0",
		"jest": "~29.7.0",
		"jest-expo": "^56.0.4",
		"react-test-renderer": "19.2.3",
		"tailwindcss": "^4.3.0",
		"typescript": "~6.0.3"
	},
	"overrides": {
		"uuid": "^14.0.0",
		"react": "19.2.3",
		"react-dom": "19.2.3"
	},
	"scripts": {
		"i18n.base": "paraglide-js compile --project ./project.inlang --outdir ./src/shared/lib/i18n --emit-ts-declarations --strategy=\"\"",
		"i18n.build": "npm run i18n.base -- --output-structure message-modules",
		"i18n.watch": "npm run i18n.base -- --watch --output-structure locale-modules --emit-readme",
		"android": "concurrently \"npm run i18n.watch\" \"expo run:android\"",
		"ios": "concurrently \"npm run i18n.watch\" \"expo run:ios\"",
		"eas-build-pre-install": "npm run i18n.build",
		"test": "jest",
		"test.coverage": "jest --coverage",
		"machine-translate": "inlang machine translate --project project.inlang",
		"---------FMT AND LINT FIX-----------": "Lint check and fix valid code",
		"biome.fix": "biome check --write --unsafe .",
		"---------FMT AND LINT CHECK-----------": "Lint check valid code only",
		"biome.check": "biome check ."
	},
	"private": true,
	"lint-staged": {
		"*": [
			"biome check --write --unsafe"
		]
	}
}
