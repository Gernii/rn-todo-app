		"cva": "^1.0.0-beta.4",
		"expo": "~56.0.4",
		"expo-constants": "~56.0.15",
		"expo-dev-client": "~56.0.15",
		"expo-device": "~56.0.4",
		"expo-font": "~56.0.5",
		"expo-image": "~56.0.9",
		"expo-linking": "~56.0.11",
