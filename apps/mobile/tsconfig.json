{
	"extends": "expo/tsconfig.base",
	"compilerOptions": {
		"strict": true,
		"paths": {
			"@/*": ["./src/*"],
			"@/assets/*": ["./assets/*"]
		},
		"types": ["jest"]
	},
	"include": [
		"**/*.ts",
		"**/*.tsx",
		"mobile/.expo/types/**/*.ts",
		"expo-env.d.ts",
		"**/src/global.css",
		"uniwind-env.d.ts"
	]
}
