{
	"$schema": "https://turborepo.dev/schema.json",
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": [".next/**", "!.next/cache/**"]
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"check-types": {
			"dependsOn": ["^check-types"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"biome.check": {
			"dependsOn": ["^biome.check"]
		},
		"biome.fix": {
			"dependsOn": ["^biome.fix"]
		},
		"test": {
			"dependsOn": ["^test"],
			"env": ["*"]
		},
		"test.ci": {
			"dependsOn": ["^test.ci"],
			"env": ["*"]
		},
		"prepare": {
			"dependsOn": ["^prepare"]
		},
		"export": {
			"dependsOn": ["^export"]
		},
		"i18n.build": {
			"dependsOn": ["^i18n.build"]
		}
	}
}
